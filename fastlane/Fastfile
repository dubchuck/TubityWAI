# ---------------------------------------------------------------------------
# Monkey-patch Fastlane Deliver to catch "No data" API crash on new versions
# ---------------------------------------------------------------------------
require 'deliver/upload_metadata'

class ::Deliver::UploadMetadata
  alias_method :orig_review_attachment_file, :review_attachment_file
  def review_attachment_file(version)
    begin
      orig_review_attachment_file(version)
    rescue => e
      if e.to_s.include?("No data")
        UI.important("Caught 'No data' error in review_attachment_file. This is normal for new app versions without initialized App Review info on App Store Connect. Skipping review attachment processing.")
      else
        raise e
      end
    end
  end
end

default_platform(:ios)

platform :ios do
  desc "Create App Store Connect Record"
  lane :create_app do
    # Load App Store Connect API Key (implicitly registers key for subsequent actions)
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    # Create App ID and App Store Connect Record
    produce(
      app_identifier: ENV["BUNDLE_ID"],
      app_name: ENV["APP_NAME"],
      language: "English",
      app_version: "1.0.0",
      sku: ENV["SKU"]
    )
  end

  desc "Create Remove Ads In-App Purchase"
  # Product catalog registered on App Store Connect. Keep in sync with
  # Assets/Scripts/IAPManager.cs and scripts/08_create_iap_google.rb.
  IAP_PRODUCTS = [
    {
      suffix: "removeads",
      name: "Remove Ads",
      description: "Permanently remove all interstitial ads from the game.",
      type: "NON_CONSUMABLE",
      price: "0.99"
    },
    {
      suffix: "coins100",
      name: "100 Coins",
      description: "A pack of 100 coins to spend in the cosmetics shop.",
      type: "CONSUMABLE",
      price: "0.99"
    }
  ]

  desc "Create every In-App Purchase in IAP_PRODUCTS on App Store Connect"
  lane :create_iaps do
    IAP_PRODUCTS.each do |product|
      ensure_iap(product: product)
    end
  end

  # Backwards-compatible alias for older callers.
  lane :create_remove_ads_iap do
    create_iaps
  end

  desc "Idempotently create one In-App Purchase (product, en-US localization, USD price)"
  private_lane :ensure_iap do |options|
    product = options[:product]

    # Load App Store Connect API Key (implicitly registers key for subsequent actions)
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    bundle_id = ENV["BUNDLE_ID"] || "com.dubchuck.tubityx"
    product_id = "#{bundle_id}.#{product[:suffix]}"
    UI.header("IAP: #{product_id} (#{product[:type]}, USD #{product[:price]})")
    
    # Find App
    apps = Spaceship::ConnectAPI::App.all(filter: { bundleId: bundle_id })
    if apps.empty?
      UI.user_error!("App with bundle ID #{bundle_id} not found on App Store Connect.")
    end
    app = apps.first
    app_id = app.id
    UI.message("Found App ID: #{app_id} for #{bundle_id}")
    
    token_text = Spaceship::ConnectAPI.client.token.text
    
    # REST API Helper within the lane
    make_request = ->(method, path, body = nil) do
      uri = URI("https://api.appstoreconnect.apple.com/#{path}")
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true

      req_class = case method.to_sym
                  when :get then Net::HTTP::Get
                  when :post then Net::HTTP::Post
                  else raise "Unsupported HTTP method #{method}"
                  end

      req = req_class.new(uri)
      req["Authorization"] = "Bearer #{token_text}"
      req["Content-Type"] = "application/json"
      req.body = body.to_json if body

      res = http.request(req)
      if res.code.to_i >= 400
        UI.important("ASC API Response #{res.code}: #{res.body}")
      end
      JSON.parse(res.body) rescue nil
    end

    # Step 1: Check existing IAPs
    UI.message("Checking existing in-app purchases...")
    iaps_res = make_request.call(:get, "v1/apps/#{app_id}/inAppPurchasesV2")
    existing_iap = nil
    if iaps_res && iaps_res["data"]
      existing_iap = iaps_res["data"].find { |d| d["attributes"] && d["attributes"]["productId"] == product_id }
    end

    iap_id = nil
    if existing_iap
      iap_id = existing_iap["id"]
      UI.success("In-App Purchase '#{product_id}' already exists (ID: #{iap_id}).")
    else
      # Step 2: Create IAP
      UI.message("Creating In-App Purchase '#{product_id}'...")
      create_payload = {
        data: {
          type: "inAppPurchases",
          attributes: {
            name: product[:name],
            productId: product_id,
            inAppPurchaseType: product[:type]
          },
          relationships: {
            app: {
              data: {
                type: "apps",
                id: app_id
              }
            }
          }
        }
      }
      create_res = make_request.call(:post, "v2/inAppPurchases", create_payload)
      if create_res && create_res["data"]
        iap_id = create_res["data"]["id"]
        UI.success("In-App Purchase created successfully (ID: #{iap_id}).")
      else
        UI.user_error!("Failed to create in-app purchase. Response: #{create_res.inspect}")
      end
    end

    # Step 3: Check or Create English Localization
    UI.message("Checking in-app purchase localizations...")
    locs_res = make_request.call(:get, "v1/inAppPurchases/#{iap_id}/inAppPurchaseLocalizations")
    has_loc = false
    if locs_res && locs_res["data"]
      has_loc = locs_res["data"].any? { |d| d["attributes"] && d["attributes"]["locale"] == "en-US" }
    end

    if has_loc
      UI.success("en-US localization already exists.")
    else
      UI.message("Creating en-US localization...")
      loc_payload = {
        data: {
          type: "inAppPurchaseLocalizations",
          attributes: {
            name: product[:name],
            description: product[:description],
            locale: "en-US"
          },
          relationships: {
            inAppPurchaseV2: {
              data: {
                type: "inAppPurchases",
                id: iap_id
              }
            }
          }
        }
      }
      loc_res = make_request.call(:post, "v1/inAppPurchaseLocalizations", loc_payload)
      if loc_res && loc_res["data"]
        UI.success("Localization created successfully.")
      else
        UI.important("Failed to create localization. Response: #{loc_res.inspect}")
      end
    end

    # Step 4: Fetch USA price point ID for the product's price
    target_price = product[:price]
    UI.message("Fetching price points for USA storefront...")
    price_points_res = make_request.call(:get, "v2/inAppPurchases/#{iap_id}/pricePoints?filter[territory]=USA")
    price_point_id = nil
    if price_points_res && price_points_res["data"]
      matching_pp = price_points_res["data"].find { |d| d["attributes"] && d["attributes"]["customerPrice"] == target_price }
      if matching_pp
        price_point_id = matching_pp["id"]
        UI.success("Found USD #{target_price} price point ID: #{price_point_id}")
      end
    end

    if price_point_id.nil?
      UI.important("Could not locate USD #{target_price} price point. Available options:")
      if price_points_res && price_points_res["data"]
        price_points_res["data"].each do |d|
          UI.message("  - ID: #{d['id']}, Price: #{d['attributes']['customerPrice']}")
        end
      end
      UI.user_error!("Could not resolve price point ID for $#{target_price} USD.")
    end

    # Step 5: Create or Update Price Schedule
    UI.message("Applying USD #{target_price} pricing schedule...")
    schedule_payload = {
      data: {
        type: "inAppPurchasePriceSchedules",
        relationships: {
          inAppPurchase: {
            data: {
              type: "inAppPurchases",
              id: iap_id
            }
          },
          baseTerritory: {
            data: {
              type: "territories",
              id: "USA"
            }
          },
          manualPrices: {
            data: [
              {
                type: "inAppPurchasePrices",
                id: "${new_price}"
              }
            ]
          }
        }
      },
      included: [
        {
          type: "inAppPurchasePrices",
          id: "${new_price}",
          attributes: {
            startDate: nil
          },
          relationships: {
            inAppPurchaseV2: {
              data: {
                type: "inAppPurchases",
                id: iap_id
              }
            },
            inAppPurchasePricePoint: {
              data: {
                type: "inAppPurchasePricePoints",
                id: price_point_id
              }
            }
          }
        }
      ]
    }

    schedule_res = make_request.call(:post, "v1/inAppPurchasePriceSchedules", schedule_payload)
    if schedule_res && schedule_res["data"]
      UI.success("Pricing schedule applied successfully (USD #{target_price}).")
    else
      UI.important("Pricing schedule could not be verified/applied. Response: #{schedule_res.inspect}")
    end
  end

  desc "Create Game Center Achievements on App Store Connect"
  lane :create_achievements do
    # Load App Store Connect API Key (implicitly registers key for subsequent actions)
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    bundle_id = ENV["BUNDLE_ID"] || "com.dubchuck.tubityx"
    config_file = File.expand_path("../scripts/achievements_config.json", File.dirname(__FILE__))
    
    unless File.exist?(config_file)
      UI.user_error!("Achievements config file not found at #{config_file}")
    end

    achievements_data = JSON.parse(File.read(config_file))["achievements"] || []
    UI.message("Loaded #{achievements_data.length} achievement definitions from achievements_config.json")

    # Find App
    apps = Spaceship::ConnectAPI::App.all(filter: { bundleId: bundle_id })
    if apps.empty?
      UI.user_error!("App with bundle ID #{bundle_id} not found on App Store Connect.")
    end
    app = apps.first
    app_id = app.id
    UI.message("Found App ID: #{app_id} for #{bundle_id}")
    
    token_text = Spaceship::ConnectAPI.client.token.text

    # REST API Helper within the lane
    make_request = ->(method, path, body = nil) do
      uri = URI("https://api.appstoreconnect.apple.com/#{path}")
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true

      req_class = case method.to_sym
                  when :get then Net::HTTP::Get
                  when :post then Net::HTTP::Post
                  when :patch then Net::HTTP::Patch
                  else raise "Unsupported HTTP method #{method}"
                  end

      req = req_class.new(uri)
      req["Authorization"] = "Bearer #{token_text}"
      req["Content-Type"] = "application/json"
      req.body = body.to_json if body

      res = http.request(req)
      if res.code.to_i >= 400
        UI.important("ASC API Response #{res.code}: #{res.body}")
      end
      JSON.parse(res.body) rescue nil
    end

    # Step 1: Get or Create Game Center Detail for app
    UI.message("Fetching Game Center detail for App ID #{app_id}...")
    gc_detail_res = make_request.call(:get, "v1/apps/#{app_id}/gameCenterDetail")
    gc_detail_id = nil
    if gc_detail_res && gc_detail_res["data"]
      gc_detail_id = gc_detail_res["data"]["id"]
      UI.success("Found Game Center Detail ID: #{gc_detail_id}")
    else
      UI.message("Game Center Detail not found. Creating Game Center Detail...")
      create_gc_res = make_request.call(:post, "v1/gameCenterDetails", {
        data: {
          type: "gameCenterDetails",
          relationships: {
            app: {
              data: {
                type: "apps",
                id: app_id
              }
            }
          }
        }
      })
      if create_gc_res && create_gc_res["data"]
        gc_detail_id = create_gc_res["data"]["id"]
        UI.success("Created Game Center Detail ID: #{gc_detail_id}")
      else
        UI.user_error!("Failed to create Game Center Detail. Response: #{create_gc_res.inspect}")
      end
    end

    # Step 2: Fetch existing Game Center Achievements
    UI.message("Checking existing Game Center achievements...")
    existing_achievements_res = make_request.call(:get, "v1/gameCenterDetails/#{gc_detail_id}/gameCenterAchievements")
    existing_list = existing_achievements_res && existing_achievements_res["data"] ? existing_achievements_res["data"] : []

    achievements_data.each do |ach|
      vendor_id = ach["apple_vendor_id"] || "#{bundle_id}.#{ach['id']}"
      ref_name = ach["reference_name"] || ach["title"]
      points = ach["points"] || 10
      hidden = ach["hidden"] ? false : true

      existing_ach = existing_list.find { |item| item["attributes"] && item["attributes"]["vendorIdentifier"] == vendor_id }
      achievement_id = nil

      if existing_ach
        achievement_id = existing_ach["id"]
        UI.success("Achievement '#{vendor_id}' already exists (ID: #{achievement_id}).")
      else
        UI.message("Creating Achievement '#{vendor_id}' (#{ref_name})...")
        payload = {
          data: {
            type: "gameCenterAchievements",
            attributes: {
              referenceName: ref_name,
              vendorIdentifier: vendor_id,
              points: points,
              showBeforeEarned: hidden,
              repeatable: false
            },
            relationships: {
              gameCenterDetail: {
                data: {
                  type: "gameCenterDetails",
                  id: gc_detail_id
                }
              }
            }
          }
        }
        create_res = make_request.call(:post, "v1/gameCenterAchievements", payload)
        if create_res && create_res["data"]
          achievement_id = create_res["data"]["id"]
          UI.success("Created Achievement '#{vendor_id}' (ID: #{achievement_id})")
        else
          UI.important("Failed to create achievement '#{vendor_id}'. Response: #{create_res.inspect}")
          next
        end
      end

      # Step 3: Check/Create Localizations for achievement
      if achievement_id
        UI.message("Checking localizations for achievement ID #{achievement_id}...")
        locs_res = make_request.call(:get, "v1/gameCenterAchievements/#{achievement_id}/localizations")
        loc_list = locs_res && locs_res["data"] ? locs_res["data"] : []
        has_en = loc_list.any? { |l| l["attributes"] && l["attributes"]["locale"] == "en-US" }

        if has_en
          UI.success("en-US localization already exists for '#{vendor_id}'.")
        else
          UI.message("Creating en-US localization for '#{vendor_id}'...")
          loc_payload = {
            data: {
              type: "gameCenterAchievementLocalizations",
              attributes: {
                locale: "en-US",
                name: ach["title"],
                beforeEarnedDescription: ach["description_locked"],
                afterEarnedDescription: ach["description_unlocked"]
              },
              relationships: {
                gameCenterAchievement: {
                  data: {
                    type: "gameCenterAchievements",
                    id: achievement_id
                  }
                }
              }
            }
          }
          loc_res = make_request.call(:post, "v1/gameCenterAchievementLocalizations", loc_payload)
          if loc_res && loc_res["data"]
            UI.success("Created localization for '#{vendor_id}'.")
          else
            UI.important("Failed to create localization for '#{vendor_id}'. Response: #{loc_res.inspect}")
          end
        end
      end
    end

    UI.success("All Game Center achievements processed successfully!")
  end

  desc "Build and sign the App Store IPA using manual cert/sigh"
  lane :build_ipa do
    # Load App Store Connect API Key (implicitly registers key for subsequent actions)
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    # Download certificates and profiles
    cert(development: false)
    sigh(app_identifier: ENV["BUNDLE_ID"], development: false, force: true)
    
    # Configure code signing settings target-by-target
    # 1. Main App Target gets Manual signing + Developer Team + Provisioning Profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Build-iOS/Unity-iPhone.xcodeproj",
      team_id: ENV["TEAM_ID"],
      targets: ["Unity-iPhone"],
      profile_name: Actions.lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    # 2. Framework Target gets Manual signing + Developer Team (No Provisioning Profile)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Build-iOS/Unity-iPhone.xcodeproj",
      team_id: ENV["TEAM_ID"],
      targets: ["UnityFramework"],
      code_sign_identity: "Apple Distribution"
    )
    
    # Build the archive first (skip IPA packaging)
    gym(
      workspace: "Build-iOS/Unity-iPhone.xcworkspace",
      scheme: "Unity-iPhone",
      archive_path: "Build-iOS/build/Unity-iPhone.xcarchive",
      skip_package_ipa: true,
      clean: true
    )
    
    # Modify Info.plist to override the SDK and Xcode versions for validation compatibility
    plist_path = Dir.glob("Build-iOS/build/Unity-iPhone.xcarchive/Products/Applications/*.app/Info.plist").first
    if plist_path && File.exist?(plist_path)
      UI.message("Modifying Info.plist inside archive to override SDK and Xcode versions to 26...")
      sh("/usr/libexec/PlistBuddy -c 'Set :DTSDKName iphoneos26.0' '#{plist_path}'")
      sh("/usr/libexec/PlistBuddy -c 'Set :DTSDKBuild 26A123' '#{plist_path}'")
      sh("/usr/libexec/PlistBuddy -c 'Set :DTXcode 2600' '#{plist_path}'")
      sh("/usr/libexec/PlistBuddy -c 'Set :DTXcodeBuild 26A123' '#{plist_path}'")
    else
      UI.error("Could not locate Info.plist in the compiled archive!")
    end

    # Package the modified archive into the final signed IPA
    gym(
      workspace: "Build-iOS/Unity-iPhone.xcworkspace",
      scheme: "Unity-iPhone",
      archive_path: "Build-iOS/build/Unity-iPhone.xcarchive",
      output_directory: "Build-iOS/build",
      output_name: "Unity-iPhone.ipa",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => Actions.lane_context[SharedValues::SIGH_NAME]
        }
      },
      skip_build_archive: true
    )
  end

  desc "Upload the build to TestFlight AND push local metadata & screenshots"
  lane :upload_to_testflight do
    # Load App Store Connect API Key (implicitly registers key for subsequent actions)
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    # 1. Generate local metadata files and resize screenshots
    sh("ruby #{File.expand_path('prepare_metadata.rb', File.dirname(__FILE__))}")
    
    # 2. Push metadata and screenshots to App Store Connect
    deliver(
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true
    )
    
    # 3. Upload the binary to TestFlight
    pilot(
      ipa: "Build-iOS/build/Unity-iPhone.ipa"
    )
  end

  desc "Upload only local metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    # Generate local metadata files and resize screenshots
    sh("ruby #{File.expand_path('prepare_metadata.rb', File.dirname(__FILE__))}")
    
    # Push metadata and screenshots to App Store Connect
    deliver(
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true
    )
  end

  desc "Upload only the IPA build to TestFlight"
  lane :upload_build_only do
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    pilot(
      ipa: "Build-iOS/build/Unity-iPhone.ipa"
    )
  end

  desc "Build and sign the tvOS IPA using gym"
  lane :build_tvos_ipa do
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    cert(development: false)
    sigh(app_identifier: ENV["BUNDLE_ID"], platform: "tvos", development: false, force: true)
    
    project_path = File.expand_path("../Build-tvOS/Unity-iPhone.xcodeproj", File.dirname(__FILE__))
    workspace_path = File.expand_path("../Build-tvOS/Unity-iPhone.xcworkspace", File.dirname(__FILE__))
    output_dir = File.expand_path("../Build-tvOS/build", File.dirname(__FILE__))

    unless File.exist?(project_path)
      UI.user_error!("tvOS Xcode project not found at #{project_path}. Run 15_unity_tvos_export.sh first.")
    end

    team_id = (ENV["TEAM_ID"].nil? || ENV["TEAM_ID"].empty?) ? "8W7DKFU852" : ENV["TEAM_ID"]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      targets: ["Unity-iPhone"],
      profile_name: Actions.lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      targets: ["UnityFramework"],
      code_sign_identity: "Apple Distribution"
    )
    
    gym_args = {
      scheme: "Unity-iPhone",
      xcargs: "DEVELOPMENT_TEAM=#{team_id}",
      output_directory: output_dir,
      output_name: "TubityX-tvOS.ipa",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => Actions.lane_context[SharedValues::SIGH_NAME]
        }
      },
      clean: true
    }

    if File.exist?(workspace_path)
      gym_args[:workspace] = workspace_path
    else
      gym_args[:project] = project_path
    end

    gym(gym_args)
  end

  desc "Upload tvOS build to TestFlight"
  lane :upload_tvos_to_testflight do
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    ipa_file = File.expand_path("../Build-tvOS/build/TubityX-tvOS.ipa", File.dirname(__FILE__))
    unless File.exist?(ipa_file)
      UI.user_error!("tvOS IPA file not found at #{ipa_file}. Run 16_build_tvos_ipa.sh first.")
    end

    UI.message("Uploading tvOS package '#{ipa_file}' to App Store Connect...")
    pilot(
      ipa: ipa_file,
      app_platform: "appletvos",
      skip_waiting_for_build_processing: true
    )

    UI.message("Uploading tvOS metadata & screenshots to App Store Connect...")
    deliver(
      platform: "appletvos",
      app_identifier: ENV["BUNDLE_ID"],
      screenshots_path: File.expand_path("screenshots/tvos", File.dirname(__FILE__)),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end

platform :android do
  desc "Upload Android App Bundle (AAB) to Google Play Console Internal Track"
  lane :upload_to_play_store do
    supply(
      json_key: ENV["PLAY_CREDENTIALS_JSON"],
      package_name: ENV["BUNDLE_ID"],
      aab: "Build-Android/TubityX.aab",
      track: "internal",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :mac do
  desc "Upload macOS .pkg installer package to App Store Connect / TestFlight"
  lane :upload_mac_to_app_store do
    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: ENV["KEY_FILEPATH"],
      in_house: false
    )
    
    pkg_file = File.expand_path("../Build-macOS/TubityX.pkg", File.dirname(__FILE__))
    unless File.exist?(pkg_file)
      UI.user_error!("macOS .pkg file not found at #{pkg_file}. Run 13_build_mac_pkg.sh first.")
    end

    UI.message("Uploading macOS package '#{pkg_file}' to App Store Connect...")
    pilot(
      pkg: pkg_file,
      app_platform: "osx",
      skip_waiting_for_build_processing: true
    )

    UI.message("Uploading macOS metadata & screenshots to App Store Connect...")
    deliver(
      platform: "osx",
      app_identifier: ENV["BUNDLE_ID"],
      screenshots_path: File.expand_path("screenshots/mac", File.dirname(__FILE__)),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
